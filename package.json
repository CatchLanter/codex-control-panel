{
  "name": "codex-control-panel",
  "version": "0.1.5",
  "description": "Codex 风格控制面板：多 CMD 窗口、会话历史与 Codex 快捷操作",
  "main": "dist/main/index.js",
  "private": true,
  "author": "local",
  "scripts": {
    "postinstall": "node scripts/fetch-pty-prebuilt.js",
    "dev": "concurrently -k -n renderer,main,electron -c cyan,green,yellow \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 dist/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.electron.json && vite build",
    "smoke": "tsc -p tsconfig.electron.json && node scripts/smoke-pty.js",
    "e2e": "tsc -p tsconfig.electron.json && node scripts/e2e-daemon.js",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
